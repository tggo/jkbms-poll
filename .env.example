# Copy to .env and fill in. .env is gitignored.

# BMS Bluetooth MAC. Find with `bluetoothctl scan le` while near the BMS,
# or in the JK BMS phone app under "Device info".
JKBMS_MAC=AA:BB:CC:DD:EE:FF

# Number of cells (B2A8S20P = 8). 1..32.
JKBMS_CELLS=8

# Where the polled JSON should land.
JKBMS_OUT=/tmp/jkbms.json

# --- deploy.sh / Makefile only (not read by the binary) ---

# SSH target where the binary runs (the host with Bluetooth in range of the BMS).
DEPLOY_HOST=user@192.168.1.2
# Remote install path for the binary.
DEPLOY_PATH=/home/user/jkbms-poll
